# URL of the deployed leonida-map-tiles repo (no trailing slash)
#   Cloudflare Pages: https://leonida-map-tiles.pages.dev
#   GitHub Pages:     https://<you>.github.io/leonida-map-tiles
#   Local:            http://localhost:8080   (npm run tiles:serve)
VITE_CDN_BASE_URL=http://localhost:8080

# Tiles folder on the CDN (change to tiles-v2 etc. when you re-cut tiles — they are cached as immutable)
VITE_TILES_PATH=tiles

# Telegram Mini App share links: t.me/<BOT>?startapp=pin_<id>  or  t.me/<BOT>/<APP>?startapp=pin_<id>
VITE_TG_BOT=
VITE_TG_APP=

# Freemium: how many "Найдено" marks are free, and where the PRO button leads (bot, landing, Stars invoice link)
VITE_FREE_LIMIT=25
VITE_PRO_URL=
